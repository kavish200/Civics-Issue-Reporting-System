{
  "name": "civics-issue-reporting-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "Backend",
    "MobileBackend"
  ],
  "scripts": {
    "test": "jest",
    "start": "npm run start -w Backend",
    "dev": "npm run dev -w Backend",
    "seed": "npm run seed -w Backend",
    "start:mobile": "npm run start -w MobileBackend",
    "dev:mobile": "npm run dev -w MobileBackend"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
